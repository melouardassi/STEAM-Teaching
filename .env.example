# Copy this file to .env and adjust as needed.

# --- Local development (default) ---
# SQLite database file, relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# --- Production / serverless hosts (Netlify, Vercel, ...) ---
# Leave these unset locally. When TURSO_DATABASE_URL is present, the app
# connects to a hosted libSQL/Turso database instead of the local file —
# required because serverless hosts have no persistent disk.
# Create a free database at https://turso.tech, then:
#   turso db create steam-hub
#   turso db show steam-hub --url          -> TURSO_DATABASE_URL
#   turso db tokens create steam-hub       -> TURSO_AUTH_TOKEN
# TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN="..."

# Used by NextAuth to sign/encrypt session tokens. Generate your own with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
